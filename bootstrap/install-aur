#!/usr/bin/env bash

if [ "$(id -u)" = 0 ] ; then
	echo 'must NOT be run as root'
	exit 1
fi

cd /tmp || exit 123

fail() {
	echo 'could not install aura'
	exit 1
}

i() {
	git clone "https://aur.archlinux.org/${1}.git" "/tmp/${1}" || fail
	pushd "/tmp/${1}" || fail
	if makepkg -si --skippgpcheck ; then
		popd || fail
		rm -rf "/tmp/${1}"
	else
		popd || fail
		rm -rf "/tmp/${1}"
		fail
	fi
}

if ! command -v aura 1>/dev/null 2>&1 ; then
	echo 'installing aura'
	sudo pacman -S git --noconfirm --needed
	i aura-bin
fi

if ! command -v aura 1>/dev/null 2>&1 ; then
	fail
fi

DOTFILES="$(dirname "$(dirname "${BASH_SOURCE[0]}")")";

packages="$(sed -e 's/\s*#.*$//g' -e '/^$/d' "$DOTFILES"/bootstrap/packages/aur)"

echo "  > installing ~ $(<<< "$packages" tr '\n' ' ')"
comm -23 \
	<(printf '%s\n' "$packages" | sort) \
	<(printf '%s\n' "$packages" | pacman -Qk - 2>/dev/null | cut -d: -f1 | sort) |
xargs -r aura -A --noconfirm

exit 0
